# Copy this file to .env and fill in real values. Never commit .env.
# Every tunable number has a safe default in src/config.ts, so only
# DATABASE_URL is strictly required.

# --- Server ---
# Port the HTTP server listens on. Render/Railway set this for you.
PORT=3000
# development | production | test. Controls error detail in logs.
NODE_ENV=development

# --- Database ---
# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/rox_restaurant
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rox_restaurant
# Production only (optional locally): a direct, non-pooled connection used by
# the Prisma CLI for migrations. On Neon, DATABASE_URL is the "pooled" string
# (host contains -pooler) and this is the plain one (no -pooler).
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Database used by `npm test`. It is DROPPED and recreated on every test run,
# so the name must end in _test (the test setup refuses anything else).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rox_restaurant_test

# --- Pagination ---
# Items returned when the client sends no ?limit.
PAGINATION_DEFAULT_LIMIT=20
# Largest ?limit honoured. Anything bigger is clamped down to this.
PAGINATION_MAX_LIMIT=100

# --- Rate limiting (per client IP) ---
# Length of the counting window in milliseconds (60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000
# Requests allowed per IP per window before 429 Too Many Requests.
RATE_LIMIT_MAX_REQUESTS=100
# Number of reverse proxies in front of the app (Render = 1). Needed so
# the limiter sees the real client IP instead of the proxy's IP.
TRUST_PROXY_HOPS=1

# --- CORS ---
# Comma-separated browser origins allowed to read the API (the consumer page).
# Production: the Netlify URL, e.g. https://YOUR-CONSUMER.netlify.app
# (scheme + host only, no trailing slash). Not needed for curl or tests.
CORS_ALLOWED_ORIGINS=http://localhost:5500

# --- Order rules ---
# Maximum distinct menu items (lines) in one order.
ORDER_MAX_LINES=20
# Maximum quantity of a single menu item in one order.
ORDER_MAX_QUANTITY_PER_LINE=99
# How many times to retry creating an order if its random reference
# (e.g. ROX-7KQ2M9XA) happens to collide with an existing one.
ORDER_REFERENCE_MAX_ATTEMPTS=3

# --- Request size ---
# Largest JSON body accepted (e.g. 100kb). Bigger bodies get 413.
JSON_BODY_LIMIT=100kb

# --- Seed volumes ---
# How many records src/seed/seed.ts generates. Menu items are generated
# per restaurant, order items per order.
SEED_RESTAURANTS=300
SEED_CUSTOMERS=500
SEED_ORDERS=800
