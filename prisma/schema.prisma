// Data model for the Rox Restaurant API.
// Conventions (see README "Resource design"):
//   - ids are UUID v7, generated by Prisma, stored as the native Postgres uuid type
//   - money is Int kobo with a currency column beside it
//   - every table has createdAt / updatedAt
// Check constraints (price >= 0, total = subtotal + fee, ...) cannot be
// written in this file; they live in the add_check_constraints migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  confirmed
  preparing
  out_for_delivery
  delivered
  cancelled
}

model Restaurant {
  id               String   @id @default(uuid(7)) @db.Uuid
  slug             String   @unique
  name             String
  cuisine          String
  area             String
  address          String
  isOpen           Boolean  @default(true)
  deliveryFeeKobo  Int
  minimumOrderKobo Int      @default(0)
  currency         String   @default("NGN") @db.Char(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  menuItems MenuItem[]
  orders    Order[]

  // Serves ?area=&cuisine= filters on the restaurant list.
  @@index([area, cuisine])
  @@map("restaurants")
}

model MenuItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  description  String?
  category     String
  priceKobo    Int
  currency     String   @default("NGN") @db.Char(3)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  // Restrict: a restaurant with menu items cannot be deleted by accident.
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  // One restaurant cannot list two dishes with the same name. The index this
  // creates starts with restaurantId, so it also serves GET /restaurants/:id/menu.
  @@unique([restaurantId, name])
  // Serves the menu-items list filtered by category and sorted by price.
  @@index([category, priceKobo])
  @@map("menu_items")
}

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  phone     String
  name      String
  area      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  reference       String      @unique
  customerId      String      @db.Uuid
  restaurantId    String      @db.Uuid
  status          OrderStatus @default(pending)
  deliveryAddress String
  subtotalKobo    Int
  deliveryFeeKobo Int
  totalKobo       Int
  currency        String      @default("NGN") @db.Char(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  // Restrict: order history must not vanish because a customer or
  // restaurant row was deleted.
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  // Serves ?customerId= (a customer's order history, newest first).
  @@index([customerId, createdAt])
  // Serves ?restaurantId=&status= (a restaurant's incoming queue).
  @@index([restaurantId, status])
  // Serves the default list sort: newest orders first.
  @@index([createdAt, id])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @db.Uuid
  menuItemId    String   @db.Uuid
  // Snapshot of the menu item at order time. Deliberate duplication: if the
  // restaurant renames the dish or raises the price later, this order must
  // still show what the customer actually bought and paid.
  nameSnapshot  String
  unitPriceKobo Int
  quantity      Int
  lineTotalKobo Int
  currency      String   @default("NGN") @db.Char(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Cascade: order lines have no meaning without their order.
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: a dish that appears in past orders cannot be deleted.
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  // The same dish appears once per order; ordering two means quantity 2.
  @@unique([orderId, menuItemId])
  // Foreign keys are not indexed automatically in Postgres. Without this,
  // checking "is this menu item used by any order?" scans the whole table.
  @@index([menuItemId])
  @@map("order_items")
}
